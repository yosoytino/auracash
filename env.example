# Copy to `.env.local` and add your Mapbox token:
#   cp env.example .env.local

# Required for Mapbox-styled map tiles (free tier at https://account.mapbox.com/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional — default is mapbox/light-v11 (muted, Instacart-like delivery aesthetic)
# Avoid streets-v12/navigation styles — they add too much line detail
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/light-v11
